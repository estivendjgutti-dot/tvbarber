<?xml version="1.0" encoding="utf-8"?>
<!-- Banner 320x180 exigido pela fileira de apps da Android TV. Troque por PNG da marca do cliente. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#0F172A" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher" android:gravity="center"
        android:width="108dp" android:height="108dp" />
</layer-list>
